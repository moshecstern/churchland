{
  "name": "contact-keeper",
  "version": "1.0.0",
  "description": "Contact manager app",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "client": "npm start --prefix client",
    "clientinstall": "npm install --prefix client",
    "seed": "ts-node scripts/seedsDB.ts",
    "heroku-postbuild": "npm run build && NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stripe/react-stripe-js": "^2.8.0",
    "@stripe/stripe-js": "^4.8.0",
    "bcryptjs": "^2.4.3",
    "config": "^3.3.12",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
